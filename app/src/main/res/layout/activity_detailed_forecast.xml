<?xml version="1.0" encoding="utf-8"?>
<!-- The ScrollView allows the entire content to be scrolled vertically -->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#3F51B5"
    tools:context=".Activities.DetailedForecast">

    <!-- The ConstraintLayout is now the single child of the ScrollView -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- CardView to hold the toolbar with rounded corners -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#5C6BC0"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationIcon="@drawable/baseline_arrow_back_24">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Detailed Forecast"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="20sp"/>

            </com.google.android.material.appbar.MaterialToolbar>

        </androidx.cardview.widget.CardView>

        <!-- CardView to hold the main weather information -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_main_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#5C6BC0"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@+id/card_toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <!-- Day of the Week -->
                <TextView
                    android:id="@+id/detail_text_view_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="Monday" />

                <!-- Date -->
                <TextView
                    android:id="@+id/detail_text_view_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="18sp"
                    android:textColor="#DEDBDB"
                    app:layout_constraintTop_toBottomOf="@+id/detail_text_view_day"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="Jul 22" />



                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/detail_image_view_weather_icon"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    app:layout_constraintTop_toBottomOf="@+id/detail_text_view_date"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    android:layout_marginTop="16dp"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/sun" />

                <!-- Main Weather Icon -->
<!--                <ImageView-->
<!--                    android:id="@+id/detail_image_view_weather_icon"-->
<!--                    android:layout_width="120dp"-->
<!--                    android:layout_height="120dp"-->
<!--                    android:scaleType="fitCenter"-->
<!--                    android:src="@drawable/sunny"-->
<!--                    app:layout_constraintTop_toBottomOf="@+id/detail_text_view_date"-->
<!--                    app:layout_constraintStart_toStartOf="parent"-->
<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    app:layout_constraintHorizontal_bias="0.5"-->
<!--                    android:layout_marginTop="16dp"-->
<!--                    tools:src="@drawable/cloud_black" />-->

                <!-- Current Temperature -->
                <TextView
                    android:id="@+id/detail_text_view_current_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/detail_image_view_weather_icon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="25°C" />

                <!-- Weather Condition -->
                <TextView
                    android:id="@+id/detail_text_view_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/detail_text_view_current_temp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="Partly Cloudy" />

                <!-- Feels Like -->
<!--                <TextView-->
<!--                    android:id="@+id/detail_text_view_feels_like"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:textSize="18sp"-->
<!--                    android:textColor="#DEDBDB"-->
<!--                    android:layout_marginTop="4dp"-->
<!--                    app:layout_constraintTop_toBottomOf="@+id/detail_text_view_condition"-->
<!--                    app:layout_constraintStart_toStartOf="parent"-->
<!--                    app:layout_constraintEnd_toEndOf="parent"-->
<!--                    tools:text="Feels like 27°C" />-->

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <!-- CardView for additional details -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_additional_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#5C6BC0"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@+id/card_main_info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

<!--                &lt;!&ndash; High/Low Temperatures &ndash;&gt;-->
<!--                <TextView-->
<!--                    android:id="@+id/detail_text_view_temp_range"-->
<!--                    android:layout_width="wrap_content"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:layout_gravity="center_horizontal"-->
<!--                    android:textSize="18sp"-->
<!--                    android:textColor="#DEDBDB"-->
<!--                    tools:text="Low: 18°C / High: 28°C" />-->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <!-- Left Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Humidity -->
                        <TextView
                            android:id="@+id/label_humidity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Humidity"
                            android:textSize="16sp"
                            android:textColor="@android:color/white" />
                        <TextView
                            android:id="@+id/detail_text_view_humidity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="#DEDBDB"
                            android:layout_marginTop="4dp"
                            tools:text="75%" />

                        <!-- Cloudiness -->
                        <TextView
                            android:id="@+id/label_cloudiness"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cloudiness"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="16dp" />
                        <TextView
                            android:id="@+id/detail_text_view_cloudiness"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="#DEDBDB"
                            android:layout_marginTop="4dp"
                            tools:text="20%" />

                        <!-- Pressure -->
                        <TextView
                            android:id="@+id/label_pressure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pressure"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="16dp" />
                        <TextView
                            android:id="@+id/detail_text_view_pressure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="#DEDBDB"
                            android:layout_marginTop="4dp"
                            tools:text="1012 hPa" />

                        <!-- Rain Possibility -->
                        <TextView
                            android:id="@+id/label_rain_possibility"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rain"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="16dp" />
                        <TextView
                            android:id="@+id/detail_text_view_rain_possibility"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="#DEDBDB"
                            android:layout_marginTop="4dp"
                            tools:text="20%" />

                    </LinearLayout>

                    <!-- Right Column -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Wind -->
                        <TextView
                            android:id="@+id/label_wind"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wind Speed"
                            android:textSize="16sp"
                            android:textColor="@android:color/white" />
                        <TextView
                            android:id="@+id/detail_text_view_wind_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="#DEDBDB"
                            android:layout_marginTop="4dp"
                            tools:text="15 km/h" />

                        <!-- Wind Gusts -->
                        <TextView
                            android:id="@+id/label_wind_gust"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wind Gusts"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="16dp" />
                        <TextView
                            android:id="@+id/detail_text_view_wind_gust"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="#DEDBDB"
                            android:layout_marginTop="4dp"
                            tools:text="25 km/h" />

                        <!-- Sunrise -->
                        <TextView
                            android:id="@+id/label_sunrise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sunrise"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="16dp" />
                        <TextView
                            android:id="@+id/detail_text_view_sunrise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="#DEDBDB"
                            android:layout_marginTop="4dp"
                            tools:text="05:30 AM" />

                        <!-- Sunset -->
                        <TextView
                            android:id="@+id/label_sunset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sunset"
                            android:textSize="16sp"
                            android:textColor="@android:color/white"
                            android:layout_marginTop="16dp" />
                        <TextView
                            android:id="@+id/detail_text_view_sunset"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="16sp"
                            android:textColor="#DEDBDB"
                            android:layout_marginTop="4dp"
                            tools:text="07:30 PM" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
