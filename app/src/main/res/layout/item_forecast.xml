<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#3F51B5">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <!-- Day of the Week -->
        <TextView
            android:id="@+id/text_view_day"
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Mon" />

        <!-- Date -->
        <TextView
            android:id="@+id/text_view_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#DEDBDB"
            android:textSize="14sp"
            android:layout_marginStart="8dp"
            app:layout_constraintStart_toEndOf="@+id/text_view_day"
            app:layout_constraintTop_toTopOf="@+id/text_view_day"
            app:layout_constraintBottom_toBottomOf="@+id/text_view_day"
            tools:text="Jul 22" />

        <!-- Weather Icon -->
<!--        <ImageView-->
<!--            android:id="@+id/image_view_weather_icon"-->
<!--            android:layout_width="48dp"-->
<!--            android:layout_height="48dp"-->
<!--            android:scaleType="fitCenter"-->
<!--            android:src="@drawable/sunny"-->
<!--            android:contentDescription="Weather Icon"-->
<!--            app:layout_constraintStart_toEndOf="@+id/text_view_date"-->
<!--            app:layout_constraintTop_toTopOf="parent"-->
<!--            app:layout_constraintBottom_toBottomOf="parent"-->
<!--            app:layout_constraintEnd_toStartOf="@id/text_view_condition"-->
<!--            tools:src="@drawable/cloud_black" />-->

        <!-- Weather Condition - Now has a flexible width to prevent overlap -->
        <TextView
            android:id="@+id/text_view_condition"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="5dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/text_view_date"
            app:layout_constraintEnd_toStartOf="@+id/text_view_temp"
            app:layout_constraintTop_toTopOf="@+id/text_view_date"
            app:layout_constraintBottom_toBottomOf="@+id/text_view_date"
            tools:text="Partly Cloudy With a Chance of Rain" />

        <!-- High Temperature -->
        <TextView
            android:id="@+id/text_view_temp"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginEnd="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="18°C - 25°C" />

        <!-- Low Temperature -->
<!--        <TextView-->
<!--            android:id="@+id/text_view_temp_high"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:textColor="@android:color/white"-->
<!--            android:textSize="16sp"-->
<!--            android:textStyle="bold"-->
<!--            app:layout_constraintEnd_toEndOf="parent"-->
<!--            app:layout_constraintTop_toTopOf="parent"-->
<!--            app:layout_constraintBottom_toBottomOf="parent"-->
<!--            tools:text="28°C" />-->

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
